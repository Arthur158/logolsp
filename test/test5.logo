; This is a comment

make "xd 5
make "xd 3

triangle :xd

to triangle :size
  repeat 3 [forward :size right 120]
end

to drawShapes :count
  make "i 0
  make "xd 5
  repeat :xd [
    right 45
    triangle 30
  ]
end

to drawShapes :count
  make "i 0
  repeat :xd [
    right 454
    triangle 30
  ]
end


drawShapes :xd